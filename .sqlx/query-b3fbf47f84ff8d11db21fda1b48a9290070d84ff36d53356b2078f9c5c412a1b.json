  "query": "\n        update links\n        set url         = coalesce($2, url),\n            title       = coalesce($3, title),\n            description = coalesce($4, description),\n            tags        = coalesce($5, tags),\n            updated_at  = now()\n        where id = $1\n        returning id, url, title, description, tags, created_at, updated_at\n        ",
