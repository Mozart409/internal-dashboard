  "db_name": "PostgreSQL",
  "query": "\n        select id, url, title, description, tags, clicks, created_at, updated_at\n        from links\n        where $1::text is null or $1 = any(tags)\n        order by\n            case when $2 = 'title' then lower(title) end asc,\n            case when $2 = 'clicks' then clicks end desc,\n            created_at desc,\n            id\n        ",
